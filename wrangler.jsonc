{
  // Cloudflare Workers with static assets — see docs/adr/0007-cloudflare-static-hosting.md.
  //
  // There is no Worker script. Every route prerenders, so this deployment is the
  // contents of `out/` and nothing else; Cloudflare serves them directly. If server
  // code is ever needed, a `main` entry point is added here and nothing else moves.
  //
  // Deploy with `pnpm deploy:cf`, which builds first. `out/_headers` is generated
  // by that build and is what carries the CSP in production.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "img-hub",
  "compatibility_date": "2026-08-31",

  // Published to <name>.<account>.workers.dev and nowhere else.
  //
  // Stated rather than left to the default, because this account also serves a
  // production site. There is deliberately no `routes`, `zone_id`, `zone_name` or
  // `custom_domain` key here: without one, a deploy cannot attach this Worker to a
  // hostname, touch a zone, or write a DNS record. Adding a custom domain later means
  // adding one of those keys, which is a visible, reviewable change.
  "workers_dev": true,

  "assets": {
    "directory": "./out",

    // Serve `/about` from `about.html` without redirecting to `/about/`, and return a
    // real 404 for anything unknown. A soft 404 tells a crawler a missing page is
    // real content.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
