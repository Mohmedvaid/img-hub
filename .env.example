# Copy to .env.local and fill in. Every value here has a safe default in config/,
# so the app runs with none of these set.

# Canonical origin used for sitemap, robots, canonical tags and OG image URLs.
# No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google AdSense publisher id, e.g. ca-pub-0000000000000000.
# Leave empty to disable all ad markup (default in dev).
NEXT_PUBLIC_ADSENSE_CLIENT=""

# Plausible/GA/etc. Leave empty to disable analytics entirely.
NEXT_PUBLIC_ANALYTICS_DOMAIN=""

# Set to "true" to allow search engines to index this deployment.
# Anything else emits a global noindex. Only production should set this.
NEXT_PUBLIC_ALLOW_INDEXING="false"
